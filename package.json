{
  "name": "aion",
  "displayName": "Aion",
  "description": "Language support for Aion: syntax highlighting, snippets, diagnostics and commands.",
  "version": "0.1.0",
  "publisher": "aionlang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aionlang/aion-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/aionlang/aion-vscode/issues"
  },
  "homepage": "https://github.com/aionlang/aion-vscode#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "aion",
    "language",
    "syntax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aion",
        "aliases": [
          "Aion",
          "aion"
        ],
        "extensions": [
          ".aion"
        ],
        "firstLine": "^#!.*\baion\b",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "aion-project",
        "aliases": [
          "Aion Project",
          "aion.project"
        ],
        "filenames": [
          "aion.project"
        ],
        "configuration": "./aion-project-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aion",
        "scopeName": "source.aion",
        "path": "./syntaxes/aion.tmLanguage.json"
      },
      {
        "language": "aion-project",
        "scopeName": "source.aion-project",
        "path": "./syntaxes/aion-project.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aion",
        "path": "./snippets/aion.json"
      }
    ],
    "commands": [
      {
        "command": "aion.run",
        "title": "Run Aion File",
        "category": "Aion",
        "icon": "$(play)"
      },
      {
        "command": "aion.build",
        "title": "Build Aion File",
        "category": "Aion",
        "icon": "$(package)"
      },
      {
        "command": "aion.check",
        "title": "Check Aion File",
        "category": "Aion",
        "icon": "$(check)"
      },
      {
        "command": "aion.test",
        "title": "Run Aion Tests",
        "category": "Aion",
        "icon": "$(beaker)"
      },
      {
        "command": "aion.format",
        "title": "Format Aion File",
        "category": "Aion"
      },
      {
        "command": "aion.repl",
        "title": "Open Aion REPL",
        "category": "Aion",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "aion.run",
          "when": "resourceLangId == aion",
          "group": "navigation@0"
        },
        {
          "command": "aion.build",
          "when": "resourceLangId == aion",
          "group": "navigation@1"
        },
        {
          "command": "aion.check",
          "when": "resourceLangId == aion",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "aion.run",
          "when": "resourceLangId == aion && resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "aion.run",
          "when": "resourceExtname == .aion",
          "group": "6_aion@1"
        },
        {
          "command": "aion.build",
          "when": "resourceExtname == .aion",
          "group": "6_aion@2"
        }
      ],
      "commandPalette": [
        {
          "command": "aion.run",
          "when": "resourceLangId == aion"
        },
        {
          "command": "aion.build",
          "when": "resourceLangId == aion"
        },
        {
          "command": "aion.check",
          "when": "resourceLangId == aion"
        },
        {
          "command": "aion.format",
          "when": "resourceLangId == aion"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aion.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == aion"
      }
    ]
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
