{
  "name": "aion",
  "displayName": "Aion",
  "description": "Language support for Aion: syntax highlighting, snippets, diagnostics and commands.",
  "version": "0.1.0",
  "publisher": "aionlang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aionlang/aion-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/aionlang/aion-vscode/issues"
  },
  "homepage": "https://github.com/aionlang/aion-vscode#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "aion",
    "language",
    "syntax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aion",
        "aliases": [
          "Aion",
          "aion"
        ],
        "extensions": [
          ".aion"
        ],
        "firstLine": "^#!.*\baion\b",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "aion-project",
        "aliases": [
          "Aion Project",
          "aion.project"
        ],
        "filenames": [
          "aion.project"
        ],
        "configuration": "./aion-project-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aion",
        "scopeName": "source.aion",
        "path": "./syntaxes/aion.tmLanguage.json"
      },
      {
        "language": "aion-project",
        "scopeName": "source.aion-project",
        "path": "./syntaxes/aion-project.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aion",
        "path": "./snippets/aion.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
