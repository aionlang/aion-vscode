{
  "name": "aion-support",
  "displayName": "Aion",
  "description": "Language support for Aion: syntax highlighting, snippets, diagnostics and commands.",
  "version": "0.1.4",
  "publisher": "aionlanguage",
  "icon": "icons/icon.png",
  "galleryBanner": {
    "color": "#101826",
    "theme": "dark"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aionlang/aion-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/aionlang/aion-vscode/issues"
  },
  "homepage": "https://github.com/aionlang/aion-vscode#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "aion",
    "language",
    "syntax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aion",
        "aliases": [
          "Aion",
          "aion"
        ],
        "extensions": [
          ".aion"
        ],
        "firstLine": "^#!.*\baion\b",
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/aion.svg",
          "dark": "./icons/aion.svg"
        }
      },
      {
        "id": "aion-project",
        "aliases": [
          "Aion Project",
          "aion.project"
        ],
        "filenames": [
          "aion.project"
        ],
        "configuration": "./aion-project-configuration.json",
        "icon": {
          "light": "./icons/aion-project.svg",
          "dark": "./icons/aion-project.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "aion",
        "scopeName": "source.aion",
        "path": "./syntaxes/aion.tmLanguage.json"
      },
      {
        "language": "aion-project",
        "scopeName": "source.aion-project",
        "path": "./syntaxes/aion-project.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aion",
        "path": "./snippets/aion.json"
      }
    ],
    "commands": [
      {
        "command": "aion.run",
        "title": "Run Aion File",
        "category": "Aion",
        "icon": "$(play)"
      },
      {
        "command": "aion.build",
        "title": "Build Aion File",
        "category": "Aion",
        "icon": "$(package)"
      },
      {
        "command": "aion.check",
        "title": "Check Aion File",
        "category": "Aion",
        "icon": "$(check)"
      },
      {
        "command": "aion.test",
        "title": "Run Aion Tests",
        "category": "Aion",
        "icon": "$(beaker)"
      },
      {
        "command": "aion.format",
        "title": "Format Aion File",
        "category": "Aion"
      },
      {
        "command": "aion.repl",
        "title": "Open Aion REPL",
        "category": "Aion",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "aion.run",
          "when": "resourceLangId == aion",
          "group": "navigation@0"
        },
        {
          "command": "aion.build",
          "when": "resourceLangId == aion",
          "group": "navigation@1"
        },
        {
          "command": "aion.check",
          "when": "resourceLangId == aion",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "aion.run",
          "when": "resourceLangId == aion && resourceScheme == file",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "aion.run",
          "when": "resourceExtname == .aion",
          "group": "6_aion@1"
        },
        {
          "command": "aion.build",
          "when": "resourceExtname == .aion",
          "group": "6_aion@2"
        }
      ],
      "commandPalette": [
        {
          "command": "aion.run",
          "when": "resourceLangId == aion"
        },
        {
          "command": "aion.build",
          "when": "resourceLangId == aion"
        },
        {
          "command": "aion.check",
          "when": "resourceLangId == aion"
        },
        {
          "command": "aion.format",
          "when": "resourceLangId == aion"
        }
      ]
    },
    "keybindings": [
      {
        "command": "aion.run",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == aion"
      }
    ],
    "configuration": {
      "title": "Aion",
      "properties": {
        "aion.path": {
          "type": "string",
          "default": "aion",
          "scope": "machine-overridable",
          "description": "The Aion compiler to run: a command on PATH, or the full path to the executable."
        },
        "aion.compilerArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Options for the compiler when running or building a file, such as [\"-O3\", \"--no-trace\"]."
        },
        "aion.run.programArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to the program by Run Aion File; the program reads them with args()."
        },
        "aion.run.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "A command line that Run Aion File sends to the terminal instead of running `aion run`. Variables: `${aion}` (the compiler, see `aion.path`), `${file}`, `${fileDirname}`, `${fileBasename}`, `${fileBasenameNoExtension}` and `${workspaceFolder}`. Example: `${aion} run -O3 ${file}`. Leave empty to run the file as a VS Code task."
        },
        "aion.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Save the file before running, building or checking it."
        },
        "aion.check.run": {
          "type": "string",
          "enum": [
            "onSave",
            "never"
          ],
          "enumDescriptions": [
            "Run `aion check` when an Aion file is opened or saved and show its problems.",
            "Only check when the Check Aion File command is used."
          ],
          "default": "onSave",
          "description": "When to type-check Aion files."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "aion",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build",
              "check",
              "test"
            ],
            "description": "The aion command to run."
          },
          "file": {
            "type": "string",
            "description": "The Aion file. Left out, the project is used."
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Compiler options, placed before the file."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arguments for the program (with run)."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "aion",
        "owner": "aion",
        "source": "aion",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning): (.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s*--> (.+):(\\d+):(\\d+)\\s*$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:aion",
    "onCommand:aion.repl",
    "onCommand:aion.test"
  ]
}
