{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aion",
  "scopeName": "source.aion",
  "fileTypes": ["aion"],
  "patterns": [
    { "include": "#shebang" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#numbers" },
    { "include": "#member-access" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#calls" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "shebang": {
      "match": "\\A#!.*$",
      "name": "comment.line.shebang.aion"
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.aion",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.aion" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.aion" } },
          "patterns": [{ "include": "#block-comment-body" }]
        },
        {
          "name": "comment.block.aion",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.aion" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.aion" } },
          "patterns": [{ "include": "#block-comment-body" }]
        },
        {
          "name": "comment.line.double-slash.aion",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.aion" } }
        }
      ]
    },
    "block-comment-body": {
      "patterns": [
        {
          "name": "comment.block.aion",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#block-comment-body" }]
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.aion",
          "begin": "\"\"\"",
          "end": "\"{3,}",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.aion" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.aion" } },
          "patterns": [{ "include": "#string-escape" }, { "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.other.raw.aion",
          "begin": "(?<![A-Za-z0-9_])r\"\"\"",
          "end": "\"{3,}",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.aion" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.aion" } }
        },
        {
          "name": "string.quoted.other.raw.aion",
          "begin": "(?<![A-Za-z0-9_])r\"",
          "end": "\"|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.aion" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.aion" } }
        },
        {
          "name": "string.quoted.double.aion",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.aion" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.aion" } },
          "patterns": [{ "include": "#string-escape" }, { "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.single.char.aion",
          "match": "'(?:[^'\\\\\\n]|\\\\u\\{[0-9a-fA-F]{1,6}\\}|\\\\[^\\n])'",
          "captures": {
            "0": {
              "patterns": [{ "include": "#string-escape" }]
            }
          }
        }
      ]
    },
    "string-escape": {
      "patterns": [
        {
          "name": "constant.character.escape.aion",
          "match": "\\\\(?:[ntr0\\\\\"'$]|u\\{[0-9a-fA-F]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.unknown-escape.aion",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.aion",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.aion" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.aion" } },
          "contentName": "source.aion",
          "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
        },
        {
          "name": "meta.interpolation.aion",
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.interpolation.aion" },
            "2": { "name": "variable.other.interpolated.aion" }
          }
        }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#interpolation-braces" }, { "include": "$self" }]
    },

    "declarations": {
      "patterns": [
        { "include": "#function-declaration" },
        { "include": "#type-declaration" },
        { "include": "#constructor-declaration" },
        { "include": "#import" },
        { "include": "#modifiers" }
      ]
    },
    "function-declaration": {
      "name": "meta.function.aion",
      "begin": "\\b(fn)\\s+(?:([A-Z][A-Za-z0-9_]*)(<[^()\\n]*?>)?\\s*(\\.)\\s*)?([A-Za-z_][A-Za-z0-9_]*)",
      "end": "(?=[={])|$",
      "beginCaptures": {
        "1": { "name": "storage.type.function.aion" },
        "2": { "name": "entity.name.type.aion" },
        "3": { "patterns": [{ "include": "#types" }, { "include": "#punctuation" }] },
        "4": { "name": "punctuation.accessor.aion" },
        "5": { "name": "entity.name.function.aion" }
      },
      "patterns": [{ "include": "#declaration-tail" }]
    },
    "type-declaration": {
      "name": "meta.type.aion",
      "begin": "\\b(type|interface|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "end": "(?=\\{)|$",
      "beginCaptures": {
        "1": { "name": "storage.type.class.aion" },
        "2": { "name": "entity.name.type.class.aion" }
      },
      "patterns": [{ "include": "#declaration-tail" }]
    },
    "constructor-declaration": {
      "name": "meta.function.constructor.aion",
      "begin": "\\b(constructor)\\b",
      "end": "(?=\\{)|$",
      "beginCaptures": { "1": { "name": "storage.type.function.constructor.aion" } },
      "patterns": [{ "include": "#declaration-tail" }]
    },
    "declaration-tail": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#parameter-list" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "parameter-list": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": { "0": { "name": "punctuation.section.parameters.begin.aion" } },
      "endCaptures": { "0": { "name": "punctuation.section.parameters.end.aion" } },
      "patterns": [
        { "include": "#parameter-list" },
        {
          "match": "\\b(vararg)\\s+(?=[A-Za-z_][A-Za-z0-9_]*\\s*:)",
          "captures": { "1": { "name": "storage.modifier.vararg.aion" } }
        },
        {
          "name": "variable.parameter.aion",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*:(?![:=]))"
        },
        { "include": "$self" }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(import)\\s+([.@A-Za-z0-9_]+)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.control.import.aion" },
            "2": { "name": "entity.name.namespace.aion" },
            "3": { "name": "keyword.control.import.aion" },
            "4": { "name": "entity.name.namespace.aion" }
          }
        },
        {
          "match": "\\b(from)\\s+([.@A-Za-z0-9_]+)\\s+(import)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.aion" },
            "2": { "name": "entity.name.namespace.aion" },
            "3": { "name": "keyword.control.import.aion" }
          }
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.aion",
          "match": "\\b(?:open|data|override|static|extern)\\b(?=\\s+(?:open|data|override|static|extern|fn|type|interface|enum)\\b)"
        },
        {
          "name": "storage.type.val.aion",
          "match": "\\bval\\b(?=\\s+[A-Za-z_(])"
        },
        {
          "name": "keyword.other.init.aion",
          "match": "^\\s*\\binit\\b(?=\\s*\\{)"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.aion",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.aion",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.aion",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.aion",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.aion",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },

    "member-access": {
      "patterns": [
        {
          "match": "(?<!\\.)(\\?\\.|\\.)(?!\\.)\\s*([a-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^()\\n]*>)?\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.aion" },
            "2": { "name": "entity.name.function.member.aion" }
          }
        },
        {
          "match": "(?<!\\.)(\\?\\.|\\.)(?!\\.)\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.aion" },
            "2": { "name": "variable.other.property.aion" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aion",
          "match": "\\b(?:if|else|while|for|in|when|break|continue|return|defer|try|catch)\\b"
        },
        {
          "name": "keyword.operator.type.aion",
          "match": "(?<=\\s)(?:as\\?|as|!?is)(?=\\s)"
        },
        {
          "name": "keyword.operator.range.aion",
          "match": "(?<=\\s)(?:step|downTo)(?=\\s)"
        },
        {
          "name": "variable.language.this.aion",
          "match": "\\b(?:this|super)\\b"
        },
        {
          "name": "variable.language.it.aion",
          "match": "\\bit\\b(?!\\s*:(?![:=]))"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.aion",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.aion",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.other.constant.aion",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },

    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.aion",
          "match": "\\b(?:print|println|eprint|eprintln|panic|typeOf|hashOf|readLine|readText)\\b"
        },
        {
          "name": "support.function.builtin.aion",
          "match": "\\b(?:args|assert|assertClose|assertContains|assertContainsText|assertEq|assertFails|assertFalse|assertNe|assertNotNull|assertNull|async|bytesOf|check|compute|cpuCount|emptyList|emptyMap|emptyStream|enumerate|error|generate|iterate|iterateWhile|launch|listOf|onDefault|onTimeout|repeat|require|runCatching|select|setOf|sleep|streamOf|streamRange|streamRangeClosed|streamRepeat|thread|threadId|waitAll|yield)\\b(?=\\s*[({])"
        },
        {
          "name": "support.function.builtin.aion",
          "match": "\\b(?:abs|clamp|max|min)\\b(?=\\s*\\()"
        }
      ]
    },

    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.aion",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*(?:<[^()\\n]*>)?\\()"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.aion",
          "match": "\\b(?:Int|Int32|Byte|Float|Bool|Char|String|Bytes|Any|Unit|Array|List|Map|Set|Range|Channel|Task|Job|Thread|Mutex|AtomicInt|StringBuilder|BytesBuilder|Result|Stream|Entry|Comparable|Stats|Tuple[2-5])\\b"
        },
        {
          "name": "entity.name.type.aion",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.range.aion", "match": "\\.\\.=?" },
        { "name": "keyword.operator.arrow.aion", "match": "->" },
        { "name": "keyword.operator.elvis.aion", "match": "\\?:" },
        { "name": "keyword.operator.null-assert.aion", "match": "!!" },
        { "name": "keyword.operator.declaration.aion", "match": "::?=" },
        { "name": "keyword.operator.assignment.compound.aion", "match": "[-+*/]=" },
        { "name": "keyword.operator.comparison.aion", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.aion", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arithmetic.aion", "match": "[-+*/%]" },
        { "name": "keyword.operator.assignment.aion", "match": "=" },
        { "name": "keyword.operator.ternary.aion", "match": "\\?" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.aion", "match": "," },
        { "name": "punctuation.terminator.statement.aion", "match": ";" },
        { "name": "punctuation.separator.colon.aion", "match": ":" },
        { "name": "punctuation.accessor.aion", "match": "\\." },
        { "name": "punctuation.definition.annotation.aion", "match": "@" }
      ]
    }
  }
}
